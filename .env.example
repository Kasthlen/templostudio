# Server Configuration
PORT=10000
NODE_ENV=production

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/templostudio?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Email Configuration (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=TemploStudio <your_email@gmail.com>

# Admin User
ADMIN_EMAIL=admin@templostudio.com
ADMIN_PASSWORD=cambia_esta_contraseña_larga

# Frontend URL
FRONTEND_URL=https://templostudio.onrender.com
