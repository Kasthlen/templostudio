# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/templostudio
# Para producción usar MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/templostudio?retryWrites=true&w=majority

# JWT Secret (cámbialo en producción)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Email: se usa el primer proveedor configurado de esta lista
# 1) Google Apps Script (recomendado en Render free, que bloquea SMTP)
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
# 2) Brevo (API HTTP)
BREVO_API_KEY=
# Correo que recibe los avisos de nuevas citas (por defecto EMAIL_USER)
ADMIN_NOTIFY_EMAIL=

# 3) SMTP Gmail (solo local o plan de pago)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=TemploStudio <your_email@gmail.com>

# Admin User (se creará automáticamente al iniciar)
ADMIN_EMAIL=admin@templostudio.com
ADMIN_PASSWORD=cambia_esta_contraseña_larga

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:8080
